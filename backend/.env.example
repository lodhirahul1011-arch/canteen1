NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/canteen_erp?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# Development-only demo seed switch. Keep false/unset in production.
SEED_DEMO_USERS=false
SEED_MASTER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_MEMBER_PASSWORD=
